generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          String   @default("player") // "player" | "admin"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Stats
  totalPoints   Int @default(0)
  totalCredits  Int @default(0)
  currentStreak Int @default(0)
  longestStreak Int @default(0)

  // Relations
  answers            Answer[]
  pointTransactions  PointTransaction[]
  creditTransactions CreditTransaction[]
  badges             Badge[]
}

model Round {
  id        String   @id @default(cuid())
  name      String
  category  String   // "government", "sg_history", "past_sbps", "wildcard"
  status    String   @default("pending") // "pending" | "active" | "completed"
  order     Int      @default(0)
  sessionId String?
  createdAt DateTime @default(now())

  questions Question[]
  answers   Answer[]
}

model Question {
  id            String   @id @default(cuid())
  text          String
  options       String   // JSON stringified array of options
  correctAnswer Int      // index of correct option (0-based)
  timeLimit     Int      @default(30) // seconds
  points        Int      @default(10)
  roundId       String
  order         Int      @default(0)
  createdAt     DateTime @default(now())

  round   Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  answers Answer[]
}

model Answer {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  roundId    String
  selected   Int      // index of selected option
  isCorrect  Boolean
  timeMs     Int      // time taken to answer in ms
  points     Int      @default(0)
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  round    Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model PointTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String   // "correct_answer", "streak_bonus", "first_correct", "round_perfect"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String   // "high_score", "referral", "weekly_top3", "redemption"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Badge {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "trivia_titan", "perfect_round", "streak_master", "first_blood"
  name      String
  awardedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model AppSettings {
  id                   String  @id @default("singleton")
  enablePunishments    Boolean @default(false)
  punishmentText       String  @default("Loser must take everyone's dishes to the kitchen and wash them if the manager allows 😂 (optional)")
  busynessCache        String? // JSON cached busyness data
  busynessCacheUpdated DateTime?
}
